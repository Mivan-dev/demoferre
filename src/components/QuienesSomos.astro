---
---
<section id="quienes" class="py-24 bg-gris-oscuro">
  <div class="max-w-6xl mx-auto px-6">

    <div class="grid md:grid-cols-2 gap-16 items-center">

      <!-- Texto -->
      <div class="fade-up">
        <p class="font-body text-amarillo text-sm font-600 tracking-widest uppercase mb-4">
          Quiénes somos
        </p>
        <h2 class="font-display font-800 uppercase text-blanco leading-none mb-6" style="font-size: clamp(2.5rem, 5vw, 4rem)">
          Más de 40 años<br/>
          <span class="text-amarillo">en el mercado</span>
        </h2>
        <p class="font-body text-gris-texto leading-relaxed mb-4">
          Fundada hace más de 40 años, DemoFerre es una ferretería industrial dedicada a la comercialización y distribución de insumos industriales.
        </p>
        <p class="font-body text-gris-texto leading-relaxed mb-10">
          Abastecemos a empresas y profesionales con abrasivos, adhesivos, lubricantes, herramientas, equipos hidráulicos, seguridad industrial, soldadura y más.
        </p>
        <a
          href="https://wa.me/5491100000000"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-amarillo text-amarillo font-body font-600 px-6 py-3 hover:bg-amarillo hover:text-negro transition-all duration-300"
        >
          Consultanos
        </a>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 gap-4 fade-up" style="transition-delay: 0.2s">
        <div class="bg-gris-medio p-8 border-l-2 border-amarillo">
          <p class="font-display font-800 text-amarillo uppercase leading-none mb-2" style="font-size: clamp(2.5rem, 4vw, 3.5rem)">+40</p>
          <p class="font-body text-gris-texto text-sm uppercase tracking-wide">Años en el mercado</p>
        </div>
        <div class="bg-gris-medio p-8 border-l-2 border-amarillo">
          <p class="font-display font-800 text-amarillo uppercase leading-none mb-2" style="font-size: clamp(2.5rem, 4vw, 3.5rem)">14</p>
          <p class="font-body text-gris-texto text-sm uppercase tracking-wide">Rubros</p>
        </div>
        <div class="bg-gris-medio p-8 border-l-2 border-amarillo">
          <p class="font-display font-800 text-amarillo uppercase leading-none mb-2" style="font-size: clamp(2.5rem, 4vw, 3.5rem)">+12</p>
          <p class="font-body text-gris-texto text-sm uppercase tracking-wide">Marcas líderes</p>
        </div>
        <div class="bg-gris-medio p-8 border-l-2 border-amarillo">
          <p class="font-display font-800 text-amarillo uppercase leading-none mb-2" style="font-size: clamp(2.5rem, 4vw, 3.5rem)">B2B</p>
          <p class="font-body text-gris-texto text-sm uppercase tracking-wide">Atención a empresas</p>
        </div>
      </div>

    </div>
  </div>
</section>