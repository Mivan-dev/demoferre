---
const rubros = [
  { nombre: 'Abrasivos', svg: '<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>' },
  { nombre: 'Adhesivos y Lubricantes', svg: '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>' },
  { nombre: 'Sistemas de Fijación', svg: '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M2 12h2M20 12h2M19.07 19.07l-1.41-1.41M5.34 5.34 3.93 3.93"/>' },
  { nombre: 'Herramientas de Corte', svg: '<path d="m6 3 6 6-4 4 1.5 1.5-4.95 4.95A2.121 2.121 0 0 1 1.5 16.4L6 12l-2-2 6-6"/><path d="m18 3-6 6 4 4-1.5 1.5 4.95 4.95a2.121 2.121 0 0 0 3.05-3.05L18 12l2-2-6-6"/>' },
  { nombre: 'Herramientas Manuales', svg: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>' },
  { nombre: 'Instrumentos de Medición', svg: '<path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/>' },
  { nombre: 'Equipos Hidráulicos', svg: '<path d="M12 2v6"/><path d="m4.93 10.93 4.24 4.24"/><path d="M2 18h6"/><path d="M16 18h6"/><path d="m14.83 15.17 4.24-4.24"/><path d="M12 22v-6"/><circle cx="12" cy="18" r="4"/>' },
  { nombre: 'Máquinas Eléctricas', svg: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>' },
  { nombre: 'Máquinas Neumáticas', svg: '<path d="M17.7 7.7a2.5 2.5 0 0 1 1.8 4.3c-1.2 1.2-4.1 3-6.3 5.2-2.2-2.2-4-5-5.2-6.3a2.5 2.5 0 0 1 4.3-1.8"/><path d="M12 6V2"/><path d="M6 12H2"/><path d="m4.6 4.6 2.8 2.8"/>' },
  { nombre: 'Maquinaria', svg: '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>' },
  { nombre: 'Matricería', svg: '<path d="m15 12-8.5 8.5c-.83.83-2.17.83-3 0 0 0 0 0 0 0a2.12 2.12 0 0 1 0-3L12 9"/><path d="M17.64 15 22 10.64"/><path d="m20.91 11.7-1.25-1.25c-.6-.6-.93-1.4-.93-2.25v-.86L16.01 5.6a5.009 5.009 0 0 0-6.22 3.18"/>' },
  { nombre: 'Seguridad Industrial', svg: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>' },
  { nombre: 'Soldadura', svg: '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>' },
  { nombre: 'Otros', svg: '<polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/>' },
];
---
<section id="rubros" class="py-24 bg-negro">
  <div class="max-w-6xl mx-auto px-6">

    <div class="mb-14 fade-up">
      <p class="font-body text-amarillo text-sm font-600 tracking-widest uppercase mb-4">
        Lo que ofrecemos
      </p>
      <h2 class="font-display font-800 uppercase text-blanco leading-none" style="font-size: clamp(2.5rem, 5vw, 4rem)">
        Nuestros <span class="text-amarillo">rubros</span>
      </h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 fade-up" style="transition-delay: 0.15s">
      {rubros.map((rubro) => (
        <div class="group bg-gris-oscuro border border-gris-medio p-6 hover:border-amarillo hover:bg-gris-medio transition-all duration-300 cursor-default">
          <svg
            class="w-7 h-7 text-amarillo mb-3"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={rubro.svg}
          />
          <p class="font-body text-blanco font-500 text-sm leading-snug group-hover:text-amarillo transition-colors duration-300">
            {rubro.nombre}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>