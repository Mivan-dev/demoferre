---
---
<section
  id="inicio"
  class="relative min-h-screen flex items-center overflow-hidden bg-negro pt-20"
>
  <!-- Fondo decorativo -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-[linear-gradient(135deg,#1A1A1A_0%,#0F0F0F_50%,#1A1A1A_100%)]"></div>
    <!-- Líneas diagonales industriales -->
    <div class="absolute top-0 right-0 w-1/2 h-full opacity-5"
      style="background-image: repeating-linear-gradient(45deg, #F5C518 0px, #F5C518 1px, transparent 1px, transparent 40px);">
    </div>
    <!-- Acento amarillo lateral -->
    <div class="absolute left-0 top-1/4 w-1 h-48 bg-amarillo"></div>
  </div>

  <!-- Contenido -->
  <div class="relative z-10 max-w-6xl mx-auto px-6 py-20">
    <div class="max-w-3xl">

      <!-- Eyebrow -->
      <p class="font-body text-amarillo text-sm font-600 tracking-widest uppercase mb-6 fade-up">
        Ferretería Industrial — Demo
      </p>

      <!-- Título -->
      <h1 class="font-display font-800 uppercase leading-none text-blanco mb-6 fade-up" style="font-size: clamp(3rem, 8vw, 7rem); transition-delay: 0.1s">
        Insumos<br/>
        <span class="text-amarillo">Industriales</span><br/>
        para tu empresa
      </h1>

      <!-- Descripción -->
      <p class="font-body text-gris-texto text-lg leading-relaxed max-w-xl mb-10 fade-up" style="transition-delay: 0.2s">
        Stock permanente en abrasivos, herramientas, soldadura, equipos hidráulicos y seguridad industrial. Asesoramiento técnico y entregas inmediatas para empresas y profesionales.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 fade-up" style="transition-delay: 0.3s">
        <a
          href="https://wa.me/5493516566484"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-amarillo text-negro font-body font-600 px-8 py-4 hover:bg-amarillo/80 transition-all duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.117.552 4.103 1.518 5.83L.057 23.998l6.305-1.65A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.001-1.37l-.36-.214-3.733.977.998-3.645-.234-.374A9.818 9.818 0 1 1 12 21.818z"/>
          </svg>
          Contactanos
        </a>
        <a
          href="/veprometcatalogo.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 border border-gris-medio text-blanco font-body font-600 px-8 py-4 hover:border-amarillo hover:text-amarillo transition-all duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          Descargar Catálogo
        </a>
      </div>

    </div>
  </div>

  <!-- Borde inferior amarillo -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-amarillo/20"></div>
</section>