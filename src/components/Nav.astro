<script>
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      nav?.classList.add('bg-negro/95', 'backdrop-blur-sm', 'border-b', 'border-amarillo/20');
    } else {
      nav?.classList.remove('bg-negro/95', 'backdrop-blur-sm', 'border-b', 'border-amarillo/20');
    }
  });

  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => menu.classList.add('hidden')));
</script>