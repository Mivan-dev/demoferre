---
---
<section id="contacto" class="py-24 bg-negro">
  <div class="max-w-6xl mx-auto px-6">

    <div class="grid md:grid-cols-2 gap-16">

      <!-- Texto -->
      <div class="fade-up">
        <p class="font-body text-amarillo text-sm font-600 tracking-widest uppercase mb-4">
          Contacto
        </p>
        <h2 class="font-display font-800 uppercase text-blanco leading-none mb-6" style="font-size: clamp(2.5rem, 5vw, 4rem)">
          ¿Necesitás <span class="text-amarillo">asesoramiento?</span>
        </h2>
        <p class="font-body text-gris-texto leading-relaxed mb-10">
          Contamos con atención personalizada para empresas y profesionales. Consultanos por stock, precios y entregas.
        </p>

        <!-- Datos -->
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-gris-medio flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-amarillo" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <p class="font-body text-blanco font-600 text-sm uppercase tracking-wide mb-1">Dirección</p>
              <p class="font-body text-gris-texto text-sm">Av. Ejemplo 1234, Córdoba, Argentina</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-gris-medio flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-amarillo" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.18 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6.29 6.29l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <p class="font-body text-blanco font-600 text-sm uppercase tracking-wide mb-1">Teléfonos</p>
              <p class="font-body text-gris-texto text-sm">351 000-0000 / 351 000-0001</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-gris-medio flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-amarillo" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <p class="font-body text-blanco font-600 text-sm uppercase tracking-wide mb-1">Horarios</p>
              <p class="font-body text-gris-texto text-sm">Lunes a Viernes — 8 a 18 hs.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA + Redes -->
      <div class="fade-up" style="transition-delay: 0.2s">
        <!-- WhatsApp -->
        <div class="bg-gris-oscuro border border-gris-medio p-8 mb-6">
          <p class="font-body text-blanco font-600 mb-2">Escribinos por WhatsApp</p>
          <p class="font-body text-gris-texto text-sm mb-6">Respuesta rápida en horario comercial.</p>
          <div class="flex flex-col gap-3">
            <a
              href="https://wa.me/5491100000000"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-amarillo text-negro font-body font-600 px-6 py-3 hover:bg-amarillo/80 transition-all duration-300"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.117.552 4.103 1.518 5.83L.057 23.998l6.305-1.65A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.001-1.37l-.36-.214-3.733.977.998-3.645-.234-.374A9.818 9.818 0 1 1 12 21.818z"/>
              </svg>
              351 000-0000
            </a>
            <a
              href="https://wa.me/5493513599800"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-gris-medio text-blanco font-body font-600 px-6 py-3 hover:border-amarillo hover:text-amarillo transition-all duration-300"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.117.552 4.103 1.518 5.83L.057 23.998l6.305-1.65A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.001-1.37l-.36-.214-3.733.977.998-3.645-.234-.374A9.818 9.818 0 1 1 12 21.818z"/>
              </svg>
              351 000-0001
            </a>
          </div>
        </div>

        <!-- Redes -->
        <div class="flex gap-4">
          <a
            href="https://www.facebook.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-12 h-12 bg-gris-oscuro border border-gris-medio flex items-center justify-center hover:border-amarillo hover:text-amarillo text-gris-texto transition-all duration-300"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-12 h-12 bg-gris-oscuro border border-gris-medio flex items-center justify-center hover:border-amarillo hover:text-amarillo text-gris-texto transition-all duration-300"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Footer -->
<footer class="py-6 bg-gris-oscuro border-t border-gris-medio">
  <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="font-display font-700 uppercase tracking-wider text-blanco text-sm">
      DEMO<span class="text-amarillo">FE</span>RRE
    </p>
    <p class="font-body text-gris-texto text-xs">
      © 2025 DemoFerre. Sitio de demostración.
    </p>
    <p class="font-body text-gris-texto text-xs">
      Diseño y desarrollo —
      <a
        href="https://portfolio-ivan-mendoza.netlify.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-amarillo hover:text-amarillo/70 transition-colors"
      >
        Iván Mendoza
      </a>
    </p>
  </div>
</footer>